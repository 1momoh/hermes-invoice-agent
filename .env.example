# PayPal sandbox app (developer.paypal.com > Apps & Credentials). Enable "Invoicing" and "Payouts" features on the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# OpenAI-compatible LLM endpoint. Default: Hermes via SSH tunnel on localhost:8642
LLM_BASE_URL=http://127.0.0.1:8642/v1
LLM_API_KEY=
LLM_MODEL=hermes-agent
# json = JSON-action fallback (Hermes); tools = native tool-calling (OpenAI, DeepSeek, ...). Auto if unset.
AGENT_MODE=
# Naira per US dollar used to convert NGN amounts (PayPal invoices do not support NGN)
NGN_PER_USD=1500
PORT=3000
